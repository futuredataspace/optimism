// SPDX-License-Identifier: MIT
pragma solidity 0.8.15;

// Testing
import { VmSafe } from "forge-std/Vm.sol";
import { Script } from "forge-std/Script.sol";
import { console } from "forge-std/console.sol";
import { stdJson } from "forge-std/StdJson.sol";
import { Strings } from "@openzeppelin/contracts/utils/Strings.sol";

// Deploy scripts
import { DeployConfig } from "scripts/deploy/DeployConfig.s.sol";
import { DeploySuperchain } from "scripts/deploy/DeploySuperchain.s.sol";
import { DeployImplementations } from "scripts/deploy/DeployImplementations.s.sol";
import { DeployOpChain } from "scripts/deploy/DeployOpChain.s.sol";
import { DeployAltDA } from "scripts/deploy/DeployAltDA.s.sol";
import { StandardConstants } from "scripts/deploy/StandardConstants.sol";
import { Artifacts } from "scripts/Artifacts.s.sol";

// Interfaces
import { IProxyAdmin } from "interfaces/universal/IProxyAdmin.sol";
import { ISuperchainConfig } from "interfaces/L1/ISuperchainConfig.sol";
import { IProtocolVersions } from "interfaces/L1/IProtocolVersions.sol";
import { IL1CrossDomainMessenger } from "interfaces/L1/IL1CrossDomainMessenger.sol";
import { ProxyAdmin } from "op-contracts-universal/ProxyAdmin.sol";

/// @title Deploy
/// @notice Script used to deploy a bedrock system. The entire system is deployed within the `run` function.
contract Deploy is Script, StandardConstants {
    /// @notice The deploy config.
    DeployConfig internal cfg;
    /// @notice The artifacts contract.
    Artifacts internal artifacts;

    /// @notice Entrypoint for the script.
    function run() public returns (bool) {
        _run(true);
        return true;
    }

    /// @notice Entrypoint for the script.
    function run(string memory _variant) public returns (bool) {
        if (Strings.equal(_variant, "no-superchain")) {
            _run(false);
        } else {
            revert("Unknown variant");
        }
        return true;
    }

    /// @notice The internal run function.
    function _run(bool _needsSuperchain) internal virtual {
        console.log("start of L1 Deploy!");

        DeploySuperchain.Output memory superchain;

        // Set up the Superchain if needed.
        if (_needsSuperchain) {
            superchain = deploySuperchain();
        } else {
            // If not deploying a new superchain, load the existing addresses from artifacts.
            superchain = DeploySuperchain.Output({
                superchainProxyAdmin: ProxyAdmin(payable(artifacts.mustGetAddress("SuperchainProxyAdmin"))),
                superchainConfigProxy: ISuperchainConfig(artifacts.mustGetAddress("SuperchainConfigProxy")),
                superchainConfigImpl: ISuperchainConfig(artifacts.mustGetAddress("SuperchainConfigImpl")),
                protocolVersionsProxy: IProtocolVersions(artifacts.mustGetAddress("ProtocolVersionsProxy")),
                protocolVersionsImpl: IProtocolVersions(artifacts.mustGetAddress("ProtocolVersionsImpl"))
            });
        }
        
        DeployImplementations.Output memory implementations = deployImplementations({ _isInterop: cfg.useInterop() });

        // Deploy Current OPChain Contracts using our custom script
        DeployOpChain opChainDeployer = new DeployOpChain();
        DeployOpChain.OpChainContracts memory opChainContracts = opChainDeployer.run(
            implementations,
            superchain,
            cfg.finalSystemOwner(),
            cfg.getSaltMerger(),
            cfg
        );

        // Save the artifacts of the OP Chain contracts
        artifacts.save("AddressManager", address(opChainContracts.addressManager));
        artifacts.save("ProxyAdmin", address(opChainContracts.proxyAdmin));
        artifacts.save("L1CrossDomainMessengerProxy", address(opChainContracts.l1CrossDomainMessengerProxy));
        artifacts.save("L1StandardBridgeProxy", address(opChainContracts.l1StandardBridgeProxy));
        artifacts.save("OptimismPortalProxy", address(opChainContracts.optimismPortalProxy));
        artifacts.save("L2OutputOracleProxy", address(opChainContracts.l2OutputOracleProxy));
        artifacts.save("SystemConfigProxy", address(opChainContracts.systemConfigProxy));
        artifacts.save("DisputeGameFactoryProxy", address(opChainContracts.disputeGameFactoryProxy));
        artifacts.save("AnchorStateRegistryProxy", address(opChainContracts.anchorStateRegistryProxy));
        artifacts.save("L1ERC721BridgeProxy", address(opChainContracts.l1ERC721BridgeProxy));
    }

    /// @notice Setup the script.
    function setUp() public virtual {
        cfg = new DeployConfig();
        artifacts = new Artifacts();
        cfg.read();
        artifacts.setUp(cfg.l1ChainID(), cfg.l2ChainID());
    }

    /// @notice Deploy the superchain contracts.
    function deploySuperchain() internal returns (DeploySuperchain.Output memory) {
        console.log("Setting up Superchain");
        DeploySuperchain ds = new DeploySuperchain();

        DeploySuperchain.Input memory input = DeploySuperchain.Input({
            finalSystemOwner: cfg.finalSystemOwner(),
            saltMixer: cfg.getSaltMixer(),
            requiredProtocolVersion: cfg.requiredProtocolVersion(),
            recommendedProtocolVersion: cfg.recommendedProtocolVersion()
        });

        DeploySuperchain.Output memory dso = ds.run(input);
        // Store the artifacts
        artifacts.save("SuperchainProxyAdmin", address(dso.superchainProxyAdmin));
        artifacts.save("SuperchainConfigProxy", address(dso.superchainConfigProxy));
        artifacts.save("SuperchainConfigImpl", address(dso.superchainConfigImpl));
        artifacts.save("ProtocolVersionsProxy", address(dso.protocolVersionsProxy));
        artifacts.save("ProtocolVersionsImpl", address(dso.protocolVersionsImpl));
        return dso;
    }

    /// @notice Deploy the implementation contracts.
    function deployImplementations(bool _isInterop) internal returns (DeployImplementations.Output memory) {
        console.log("Deploying implementation contracts");
        DeployImplementations di = new DeployImplementations();

        // We need to read the superchain proxy admin from the artifacts because it's not returned
        // by the deploySuperchain function.
        IProxyAdmin superchainProxyAdmin = IProxyAdmin(artifacts.mustGetAddress("SuperchainProxyAdmin"));

        DeployImplementations.Input memory input = DeployImplementations.Input({
            salt: keccak256(bytes(cfg.getSaltMixer())),
            withdrawalDelaySeconds: cfg.faultGameWithdrawalDelay(),
            minProposalSizeBytes: cfg.preimageOracleMinProposalSize(),
            challengePeriodSeconds: cfg.preimageOracleChallengePeriod(),
            proofMaturityDelaySeconds: cfg.proofMaturityDelaySeconds(),
            disputeGameFinalityDelaySeconds: cfg.disputeGameFinalityDelaySeconds(),
            mipsVersion: StandardConstants.MIPS_VERSION,
            l1ContractsRelease: "dev",
            protocolVersionsProxy: IProtocolVersions(artifacts.mustGetAddress("ProtocolVersionsProxy")),
            superchainConfigProxy: ISuperchainConfig(artifacts.mustGetAddress("SuperchainConfigProxy")),
            superchainProxyAdmin: superchainProxyAdmin,
            upgradeController: superchainProxyAdmin.owner(),
            challenger: cfg.l2OutputOracleChallenger()
        });

        DeployImplementations.Output memory dio = di.run(input);
        // Store the artifacts
        // Note: l2OutputOracleImpl is not deployed by DeployImplementations.s.sol in our new flow
        artifacts.save("OptimismPortalImpl", address(dio.optimismPortalImpl));
        artifacts.save("L1CrossDomainMessengerImpl", address(dio.l1CrossDomainMessengerImpl));
        artifacts.save("L1StandardBridgeImpl", address(dio.l1StandardBridgeImpl));
        artifacts.save("L1ERC721BridgeImpl", address(dio.l1ERC721BridgeImpl));
        artifacts.save("SystemConfigImpl", address(dio.systemConfigImpl));
        artifacts.save("DisputeGameFactoryImpl", address(dio.disputeGameFactoryImpl));
        artifacts.save("AnchorStateRegistryImpl", address(dio.anchorStateRegistryImpl));
        return dio;
    }
}
