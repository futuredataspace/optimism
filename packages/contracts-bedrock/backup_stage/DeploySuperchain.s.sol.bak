// SPDX-License-Identifier: MIT
pragma solidity >=0.8.15 <0.9.0;

import { Script } from "forge-std/Script.sol";
import { console } from "forge-std/console.sol";

import { ISuperchainConfig } from "interfaces/L1/ISuperchainConfig.sol";
import { IProtocolVersions, ProtocolVersion } from "interfaces/L1/IProtocolVersions.sol";
import { ProxyAdmin } from "op-contracts-universal/ProxyAdmin.sol";
import { IProxy } from "interfaces/universal/IProxy.sol";

import { DeployUtils } from "scripts/libraries/DeployUtils.sol";
import { DeployConfig } from "scripts/deploy/DeployConfig.s.sol";

contract DeploySuperchain is Script {
    /// @notice The key used to derive the salt for CREATE2 deployments.
    string internal constant DEPLOY_SUPERCHAIN_SALT_KEY = "DeploySuperchain";

    struct Input {
        address finalSystemOwner;
        string saltMixer;
        uint256 requiredProtocolVersion;
        uint256 recommendedProtocolVersion;
    }

    struct Output {
        ProxyAdmin superchainProxyAdmin;
        ISuperchainConfig superchainConfigProxy;
        ISuperchainConfig superchainConfigImpl;
        IProtocolVersions protocolVersionsProxy;
        IProtocolVersions protocolVersionsImpl;
    }

    struct DeployAndInitializeSuperchainConfigInput {
        bytes32 _salt;
        ProxyAdmin _superchainProxyAdmin;
    }

    struct DeployAndInitializeProtocolVersionsInput {
        bytes32 _salt;
        ProxyAdmin _superchainProxyAdmin;
    }

    /// @notice Run the deployment script.
    /// @param _input The input parameters for the deployment.
    /// @return output_ The addresses of the deployed contracts.
    function run(Input memory _input) public returns (Output memory output_) {
        bytes32 salt = keccak256(abi.encodePacked(DEPLOY_SUPERCHAIN_SALT_KEY, _input.saltMixer));

        console.log("Deploying Superchain contracts with salt:", vm.toString(salt));

        output_.superchainProxyAdmin = deployProxyAdmin(salt, _input.finalSystemOwner);

        DeployAndInitializeSuperchainConfigInput memory superchainConfigInput =
            DeployAndInitializeSuperchainConfigInput({ _salt: salt, _superchainProxyAdmin: output_.superchainProxyAdmin });
        (output_.superchainConfigImpl, output_.superchainConfigProxy) =
            deployAndInitializeSuperchainConfig(superchainConfigInput);

        DeployAndInitializeProtocolVersionsInput memory protocolVersionsInput =
            DeployAndInitializeProtocolVersionsInput({ _salt: salt, _superchainProxyAdmin: output_.superchainProxyAdmin });
        (output_.protocolVersionsImpl, output_.protocolVersionsProxy) =
            deployAndInitializeProtocolVersions(
                protocolVersionsInput, _input.finalSystemOwner, _input.requiredProtocolVersion, _input.recommendedProtocolVersion
            );

        // Final ownership transfer of the proxy admin
        vm.startPrank(output_.superchainProxyAdmin.owner());
        output_.superchainProxyAdmin.transferOwnership(_input.finalSystemOwner);
        vm.stopPrank();
    }

    /// @notice Deploy the ProxyAdmin contract.
    /// @param _salt The salt to use for the deployment.
    /// @param _finalSystemOwner The final owner of the ProxyAdmin.
    /// @return proxyAdmin_ The address of the deployed ProxyAdmin contract.
    function deployProxyAdmin(bytes32 _salt, address _finalSystemOwner) internal returns (ProxyAdmin proxyAdmin_) {
        bytes32 proxyAdminSalt = keccak256(abi.encodePacked("ProxyAdmin", _salt));
        bytes memory args = abi.encode(_finalSystemOwner);
        address proxyAdminAddr = DeployUtils.create2("ProxyAdmin", args, proxyAdminSalt);
        proxyAdmin_ = ProxyAdmin(payable(proxyAdminAddr));
        DeployUtils.assertValidContractAddress(address(proxyAdmin_));
        vm.label(address(proxyAdmin_), "SuperchainProxyAdmin");
    }

    /// @notice Deploy and initialize the SuperchainConfig contract.
    /// @param _input The input parameters for the deployment.
    /// @return superchainConfigImpl The address of the implementation contract.
    /// @return superchainConfigProxy The address of the proxy contract.
    function deployAndInitializeSuperchainConfig(DeployAndInitializeSuperchainConfigInput memory _input)
        private
        returns (ISuperchainConfig superchainConfigImpl, ISuperchainConfig superchainConfigProxy)
    {
        bytes32 implSalt = keccak256(abi.encodePacked("SuperchainConfigImpl", _input._salt));
        address impl = DeployUtils.create2("SuperchainConfig", implSalt);
        superchainConfigImpl = ISuperchainConfig(impl);

        bytes32 proxySalt = keccak256(abi.encodePacked("SuperchainConfigProxy", _input._salt));
        address proxy =
            DeployUtils.create2("TransparentUpgradeableProxy", abi.encode(impl, _input._superchainProxyAdmin, ""));
        superchainConfigProxy = ISuperchainConfig(proxy);

        superchainConfigProxy.initialize();

        vm.label(address(superchainConfigImpl), "SuperchainConfigImpl");
        vm.label(address(superchainConfigProxy), "SuperchainConfigProxy");
    }

    /// @notice Deploy and initialize the ProtocolVersions contract.
    /// @param _input The input parameters for the deployment.
    /// @param _finalSystemOwner The final owner of the contracts.
    /// @param _required The required protocol version.
    /// @param _recommended The recommended protocol version.
    /// @return protocolVersionsImpl The address of the implementation contract.
    /// @return protocolVersionsProxy The address of the proxy contract.
    function deployAndInitializeProtocolVersions(
        DeployAndInitializeProtocolVersionsInput memory _input,
        address _finalSystemOwner,
        uint256 _required,
        uint256 _recommended
    ) private returns (IProtocolVersions protocolVersionsImpl, IProtocolVersions protocolVersionsProxy) {
        bytes32 implSalt = keccak256(abi.encodePacked("ProtocolVersionsImpl", _input._salt));
        address impl = DeployUtils.create2("ProtocolVersions", implSalt);
        protocolVersionsImpl = IProtocolVersions(impl);

        bytes32 proxySalt = keccak256(abi.encodePacked("ProtocolVersionsProxy", _input._salt));
        address proxy =
            DeployUtils.create2("TransparentUpgradeableProxy", abi.encode(impl, _input._superchainProxyAdmin, ""));
        protocolVersionsProxy = IProtocolVersions(proxy);

        protocolVersionsProxy.initialize(
            _finalSystemOwner, ProtocolVersion.wrap(_required), ProtocolVersion.wrap(_recommended)
        );

        vm.label(address(protocolVersionsImpl), "ProtocolVersionsImpl");
        vm.label(address(protocolVersionsProxy), "ProtocolVersionsProxy");
    }
}