// SPDX-License-Identifier: MIT
pragma solidity >=0.8.15 <0.9.0;

import { Script } from "forge-std/Script.sol";
import { console } from "forge-std/console.sol";

import { Artifacts } from "scripts/Artifacts.s.sol";
import { DeployUtils } from "scripts/libraries/DeployUtils.sol";

import { ProxyAdmin } from "op-contracts-universal/ProxyAdmin.sol";
import { SuperchainConfig } from "src/L1/SuperchainConfig.sol";
import { ProtocolVersions } from "src/L1/ProtocolVersions.sol";
import { SystemConfig } from "src/L1/SystemConfig.sol";
import { L1CrossDomainMessenger } from "src/L1/L1CrossDomainMessenger.sol";
import { L1ERC721Bridge } from "src/L1/L1ERC721Bridge.sol";
import { L1StandardBridge } from "src/L1/L1StandardBridge.sol";
import { OptimismPortal2 as OptimismPortalImpl } from "src/L1/OptimismPortal2.sol";
import { DisputeGameFactory } from "src/dispute/DisputeGameFactory.sol";
import { AnchorStateRegistry } from "src/dispute/AnchorStateRegistry.sol";
import { AddressManager } from "src/legacy/AddressManager.sol";
import { TransparentUpgradeableProxy } from "@openzeppelin/contracts/proxy/transparent/TransparentUpgradeableProxy.sol";

import { ISuperchainConfig } from "interfaces/L1/ISuperchainConfig.sol";
import { IProtocolVersions, ProtocolVersion } from "interfaces/L1/IProtocolVersions.sol";
import { ISystemConfig } from "interfaces/L1/ISystemConfig.sol";
import { IL1CrossDomainMessenger } from "interfaces/L1/IL1CrossDomainMessenger.sol";
import { IL1ERC721Bridge } from "interfaces/L1/IL1ERC721Bridge.sol";
import { IL1StandardBridge } from "interfaces/L1/IL1StandardBridge.sol";
import { IOptimismPortal2 as IOptimismPortal } from "interfaces/L1/IOptimismPortal2.sol";
import { IDisputeGameFactory } from "interfaces/dispute/IDisputeGameFactory.sol";
import { IAnchorStateRegistry } from "interfaces/dispute/IAnchorStateRegistry.sol";
import { IETHLockbox } from "interfaces/L1/IETHLockbox.sol";
import { IResourceMetering } from "interfaces/L1/IResourceMetering.sol";

contract ApertiumDeployer is Script {
    Artifacts internal artifacts;

    // ========= STAGE 1: SUPERCHAIN =========
    function deployStage1_Superchain(
        string memory saltMixer,
        address superchainConfigGuardian,
        address finalSystemOwner,
        uint256 requiredProtocolVersion,
        uint256 recommendedProtocolVersion
    ) public {
        _setupWriter("apertium-1-superchain-contracts.json");
        console.log("APERTIUM DEPLOYER | STAGE 1: Deploying Superchain Contracts...");

        bytes32 salt = keccak256(abi.encodePacked("apertium.superchain", saltMixer));

        vm.startBroadcast();

        address proxyAdminOwner = msg.sender;
        bytes32 proxyAdminSalt = keccak256(abi.encodePacked("ProxyAdmin", salt));
        ProxyAdmin superchainProxyAdmin = new ProxyAdmin{salt: proxyAdminSalt}(proxyAdminOwner);
        artifacts.save("SuperchainProxyAdmin", address(superchainProxyAdmin));

        // SuperchainConfig
        bytes32 scImplSalt = keccak256(abi.encodePacked("SuperchainConfigImpl", salt));
        SuperchainConfig scImpl = new SuperchainConfig{salt: scImplSalt}();
        artifacts.save("SuperchainConfigImpl", address(scImpl));
        address scProxyAddr = _deployProxy("SuperchainConfigProxy", salt, address(scImpl), superchainProxyAdmin);

        // 初始化（由广播账户直接调用）
        ISuperchainConfig(payable(scProxyAddr)).initialize(superchainConfigGuardian);

        // ProtocolVersions
        bytes32 pvImplSalt = keccak256(abi.encodePacked("ProtocolVersionsImpl", salt));
        ProtocolVersions pvImpl = new ProtocolVersions{salt: pvImplSalt}();
        artifacts.save("ProtocolVersionsImpl", address(pvImpl));
        address pvProxyAddr = _deployProxy("ProtocolVersionsProxy", salt, address(pvImpl), superchainProxyAdmin);

        IProtocolVersions(payable(pvProxyAddr)).initialize(
            finalSystemOwner,
            ProtocolVersion.wrap(requiredProtocolVersion),
            ProtocolVersion.wrap(recommendedProtocolVersion)
        );

        // 交接 ProxyAdmin 所有权
        superchainProxyAdmin.transferOwnership(finalSystemOwner);

        vm.stopBroadcast();

        console.log("[SUCCESS] APERTIUM DEPLOYER | STAGE 1: Superchain contracts deployed.");
    }

    // ========= STAGE 2: IMPLEMENTATIONS =========
    function deployStage2_Implementations(
        string memory saltMixer,
        uint256 proofMaturityDelaySeconds,
        uint256 disputeGameFinalityDelaySeconds
    ) public {
        _setupWriter("apertium-2-implementations-contracts.json");
        console.log("APERTIUM DEPLOYER | STAGE 2: Deploying Implementation Contracts...");

        bytes32 salt = keccak256(abi.encodePacked("apertium.implementations", saltMixer));

        vm.startBroadcast();

        artifacts.save("AddressManagerImpl", address(new AddressManager{salt: salt}()));
        artifacts.save("SystemConfigImpl", address(new SystemConfig{salt: salt}()));
        artifacts.save("L1CrossDomainMessengerImpl", address(new L1CrossDomainMessenger{salt: salt}()));
        artifacts.save("L1ERC721BridgeImpl", address(new L1ERC721Bridge{salt: salt}()));
        artifacts.save("L1StandardBridgeImpl", address(new L1StandardBridge{salt: salt}()));
        artifacts.save("OptimismPortalImpl", address(new OptimismPortalImpl{salt: salt}(proofMaturityDelaySeconds)));
        artifacts.save("DisputeGameFactoryImpl", address(new DisputeGameFactory{salt: salt}()));
        artifacts.save("AnchorStateRegistryImpl", address(new AnchorStateRegistry{salt: salt}(disputeGameFinalityDelaySeconds)));

        vm.stopBroadcast();

        console.log("[SUCCESS] APERTIUM DEPLOYER | STAGE 2: Implementation contracts deployed.");
    }

    // ========= STAGE 3: PROXIES =========
    function deployStage3_Proxies(string memory saltMixer) public {
        // 读取实现清单（直接解析 JSON；不使用 Artifacts 读取）
        string memory implPath = _resolveImplPath();
        console.log("Reading implementations from %s", implPath);

        string memory json = vm.readFile(implPath);

        address addr_AddressManagerImpl         = vm.parseJsonAddress(json, ".AddressManagerImpl");
        address addr_SystemConfigImpl           = vm.parseJsonAddress(json, ".SystemConfigImpl");
        address addr_OptimismPortalImpl         = vm.parseJsonAddress(json, ".OptimismPortalImpl");
        address addr_L1CrossDomainMessengerImpl = vm.parseJsonAddress(json, ".L1CrossDomainMessengerImpl");
        address addr_L1StandardBridgeImpl       = vm.parseJsonAddress(json, ".L1StandardBridgeImpl");
        address addr_DisputeGameFactoryImpl     = vm.parseJsonAddress(json, ".DisputeGameFactoryImpl");
        address addr_AnchorStateRegistryImpl    = vm.parseJsonAddress(json, ".AnchorStateRegistryImpl");
        address addr_L1ERC721BridgeImpl         = vm.parseJsonAddress(json, ".L1ERC721BridgeImpl");

        // 前置“有码”校验，避免 ERC1967 含糊错误
        _requireContract(addr_AddressManagerImpl,         "AddressManagerImpl");
        _requireContract(addr_SystemConfigImpl,           "SystemConfigImpl");
        _requireContract(addr_OptimismPortalImpl,         "OptimismPortalImpl");
        _requireContract(addr_L1CrossDomainMessengerImpl, "L1CrossDomainMessengerImpl");
        _requireContract(addr_L1StandardBridgeImpl,       "L1StandardBridgeImpl");
        _requireContract(addr_DisputeGameFactoryImpl,     "DisputeGameFactoryImpl");
        _requireContract(addr_AnchorStateRegistryImpl,    "AnchorStateRegistryImpl");
        _requireContract(addr_L1ERC721BridgeImpl,         "L1ERC721BridgeImpl");

        // 切到代理产物文件，开始写入
        _setupWriter("apertium-3-opchain-contracts.json");
        console.log("APERTIUM DEPLOYER | STAGE 3: Deploying Proxies...");

        bytes32 salt = keccak256(abi.encodePacked("apertium.opchain", saltMixer));

        vm.startBroadcast();

        address proxyAdminOwner = msg.sender;
        bytes32 opProxyAdminSalt = keccak256(abi.encodePacked("ProxyAdmin", salt));
        ProxyAdmin opProxyAdmin = new ProxyAdmin{salt: opProxyAdminSalt}(proxyAdminOwner);
        artifacts.save("ProxyAdmin", address(opProxyAdmin));

        // 每个 proxy 部署前打印一下实现地址，便于链上排障
        console.log("-> AddressManagerProxy  impl %s", addr_AddressManagerImpl);
        _deployProxy("AddressManagerProxy",          salt, addr_AddressManagerImpl,         opProxyAdmin);

        console.log("-> SystemConfigProxy    impl %s", addr_SystemConfigImpl);
        _deployProxy("SystemConfigProxy",            salt, addr_SystemConfigImpl,           opProxyAdmin);

        console.log("-> OptimismPortalProxy  impl %s", addr_OptimismPortalImpl);
        address opProxyAddr = _deployProxy("OptimismPortalProxy", salt, addr_OptimismPortalImpl, opProxyAdmin);

        console.log("-> L1XDomainMsgProxy   impl %s", addr_L1CrossDomainMessengerImpl);
        _deployProxy("L1CrossDomainMessengerProxy",  salt, addr_L1CrossDomainMessengerImpl, opProxyAdmin);

        console.log("-> L1StandardBridge    impl %s", addr_L1StandardBridgeImpl);
        _deployProxy("L1StandardBridgeProxy",        salt, addr_L1StandardBridgeImpl,       opProxyAdmin);

        console.log("-> DisputeGameFactory  impl %s", addr_DisputeGameFactoryImpl);
        _deployProxy("DisputeGameFactoryProxy",      salt, addr_DisputeGameFactoryImpl,     opProxyAdmin);

        console.log("-> AnchorStateRegistry impl %s", addr_AnchorStateRegistryImpl);
        _deployProxy("AnchorStateRegistryProxy",     salt, addr_AnchorStateRegistryImpl,    opProxyAdmin);

        console.log("-> L1ERC721Bridge      impl %s", addr_L1ERC721BridgeImpl);
        _deployProxy("L1ERC721BridgeProxy",          salt, addr_L1ERC721BridgeImpl,         opProxyAdmin);

        // 兼容老键名
        artifacts.save("L2OutputOracleProxy", opProxyAddr);

        vm.stopBroadcast();

        console.log("[SUCCESS] APERTIUM DEPLOYER | STAGE 3: Proxies deployed.");
    }

    // ----------------- Internal Helpers -----------------

    // 仅用于“写入”某个产物文件
    function _setupWriter(string memory fileName) internal {
        artifacts = new Artifacts();

        string memory outfile;
        try vm.envString("DEPLOYMENT_OUTFILE") returns (string memory v) {
            outfile = v;
        } catch {
            outfile = string.concat("generated/", fileName);
        }

        vm.envString("DEPLOYMENT_OUTFILE", outfile);
        artifacts.setUp();
    }

    // 解析实现清单路径：优先 env IMPLEMENTATION_OUTFILE，其次新默认，最后老文件名
    function _resolveImplPath() internal returns (string memory pathToUse) {
        string memory primary;
        try vm.envString("IMPLEMENTATION_OUTFILE") returns (string memory v) {
            primary = v;
        } catch {
            primary = "generated/apertium-2-implementations-contracts.json";
        }

        // 如果 primary 不存在，则回退到旧名
        try vm.readFile(primary) returns (string memory) {
            pathToUse = primary;
            return pathToUse;
        } catch {
            pathToUse = "generated/apertium-2-implementation-contracts.json";
            vm.readFile(pathToUse); // 让不存在直接 revert
            return pathToUse;
        }
    }

    // 实现必须是“有码地址”
    function _requireContract(address a, string memory name) internal view {
        require(a != address(0), string(abi.encodePacked(name, " impl is zero address")));
        require(a.code.length > 0, string(abi.encodePacked(name, " impl has no code on-chain")));
    }

    function _deployProxy(
        string memory _name,
        bytes32 _salt,
        address _impl,
        ProxyAdmin _admin
    ) internal returns (address addr_) {
        bytes32 proxySalt = keccak256(abi.encodePacked(_name, _salt));
        TransparentUpgradeableProxy proxy =
            new TransparentUpgradeableProxy{salt: proxySalt}(_impl, address(_admin), bytes(""));
        addr_ = address(proxy);
        artifacts.save(_name, addr_);
    }
}
