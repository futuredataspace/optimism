// SPDX-License-Identifier: MIT
pragma solidity 0.8.15;

import {Script} from "forge-std/Script.sol";

import {ISuperchainConfig} from "interfaces/L1/ISuperchainConfig.sol";
import {IProtocolVersions, ProtocolVersion} from "interfaces/L1/IProtocolVersions.sol";
import {IProxyAdmin} from "interfaces/universal/IProxyAdmin.sol";
import {IProxy} from "interfaces/universal/IProxy.sol";

import {DeployUtils} from "scripts/libraries/DeployUtils.sol";
// Solarray / DeployUtils 的断言里可能会 prank，这里我们自己做最小断言，不再用它们的断言辅助。
// import {Solarray} from "scripts/libraries/Solarray.sol";

// ---- EIP-1967 slots ----
bytes32 constant _EIP1967_IMPLEMENTATION_SLOT =
    bytes32(uint256(keccak256("eip1967.proxy.implementation")) - 1);
bytes32 constant _EIP1967_ADMIN_SLOT =
    bytes32(uint256(keccak256("eip1967.proxy.admin")) - 1);

contract DeploySuperchain is Script {
    struct Input {
        address guardian;
        address protocolVersionsOwner;
        address superchainProxyAdminOwner;
        bool    paused;
        bytes32 recommendedProtocolVersion; // will wrap to ProtocolVersion
        bytes32 requiredProtocolVersion;    // will wrap to ProtocolVersion
    }

    struct InternalInput {
        address guardian;
        address protocolVersionsOwner;
        address superchainProxyAdminOwner;
        address deployer; // 用于在未外层广播时临时广播
        bool    paused;
        ProtocolVersion recommendedProtocolVersion;
        ProtocolVersion requiredProtocolVersion;
    }

    struct Output {
        IProtocolVersions protocolVersionsImpl;
        IProtocolVersions protocolVersionsProxy;
        ISuperchainConfig superchainConfigImpl;
        ISuperchainConfig superchainConfigProxy;
        IProxyAdmin       superchainProxyAdmin;
    }

    bytes32 internal _salt = DeployUtils.DEFAULT_SALT;

    // ---------- 内部工具 ----------
    // 用 cheatcode 直接读别的合约的 storage 槽（只能在 Script 里用）
    function _readEIP1967(address proxy, bytes32 slot) internal view returns (address a) {
        bytes32 v = vm.load(proxy, slot);
        a = address(uint160(uint256(v)));
    }

    // 安全广播：如果外层已 broadcast，这里不会再次开启
    function _tryStartBroadcast(address from) internal returns (bool didStart) {
        // 兼容性最强的写法：直接试，失败就说明外层在播
        try vm.startBroadcast() {
            return true;
        } catch {
            return false;
        }
    }
    function _tryStopBroadcast(bool didStart) internal {
        if (didStart) vm.stopBroadcast();
    }

    // ---------- 入口 ----------
    function run(Input memory _input) public returns (Output memory output_) {
        InternalInput memory internalInput = toInternalInput(_input);

        // 如果你希望从外层传入 deployer，可把这句删掉；这里给一个默认值兜底
        if (internalInput.deployer == address(0)) {
            internalInput.deployer = msg.sender; // 退化：用当前 msg.sender
        }

        _assertValidInput(internalInput);

        // 1) 部署 ProxyAdmin（owner = 本脚本合约地址），后续由本合约发起升级
        _deploySuperchainProxyAdmin(internalInput, output_);

        // 2) 部署实现
        _deployImplementations(internalInput, output_);

        // 3) 部署 SuperchainConfig 代理并初始化（guardian, paused）
        _deployAndInitSuperchainConfig(internalInput, output_);

        // 4) 部署 ProtocolVersions 代理并初始化（owner, recommended, required）
        _deployAndInitProtocolVersions(internalInput, output_);

        // 5) 最后移交 ProxyAdmin.owner 给目标 EOA
        _transferProxyAdminOwnership(internalInput, output_);

        // 6) 最小校验（不使用会 prank 的断言）
        _assertValidOutput(internalInput, output_);
    }

    // ---------- 步骤实现 ----------
    function _deploySuperchainProxyAdmin(InternalInput memory _in, Output memory _out) private {
        bool b = _tryStartBroadcast(_in.deployer);
        // 通过 DeployUtils.create1 直接 new ProxyAdmin(owner = address(this))
        IProxyAdmin superchainProxyAdmin = IProxyAdmin(
            DeployUtils.create1({
                _name: "ProxyAdmin",
                _args: DeployUtils.encodeConstructor(
                    abi.encodeCall(IProxyAdmin.__constructor__, (address(this)))
                )
            })
        );
        _tryStopBroadcast(b);

        vm.label(address(superchainProxyAdmin), "SuperchainProxyAdmin");
        _out.superchainProxyAdmin = superchainProxyAdmin;
    }

    function _deployImplementations(InternalInput memory _in, Output memory _out) private {
        bool b = _tryStartBroadcast(_in.deployer);
        ISuperchainConfig superchainConfigImpl = ISuperchainConfig(
            DeployUtils.createDeterministic({
                _name: "SuperchainConfig",
                _args: DeployUtils.encodeConstructor(
                    abi.encodeCall(ISuperchainConfig.__constructor__, ())
                ),
                _salt: _salt
            })
        );
        IProtocolVersions protocolVersionsImpl = IProtocolVersions(
            DeployUtils.createDeterministic({
                _name: "ProtocolVersions",
                _args: DeployUtils.encodeConstructor(
                    abi.encodeCall(IProtocolVersions.__constructor__, ())
                ),
                _salt: _salt
            })
        );
        _tryStopBroadcast(b);

        vm.label(address(superchainConfigImpl), "SuperchainConfigImpl");
        vm.label(address(protocolVersionsImpl), "ProtocolVersionsImpl");

        _out.superchainConfigImpl = superchainConfigImpl;
        _out.protocolVersionsImpl = protocolVersionsImpl;
    }

    function _deployAndInitSuperchainConfig(InternalInput memory _in, Output memory _out) private {
        IProxyAdmin superchainProxyAdmin = _out.superchainProxyAdmin;
        ISuperchainConfig superchainConfigImpl = _out.superchainConfigImpl;

        // 先部署 Proxy（admin=ProxyAdmin）
        bool b1 = _tryStartBroadcast(_in.deployer);
        ISuperchainConfig superchainConfigProxy = ISuperchainConfig(
            DeployUtils.create1({
                _name: "Proxy",
                _args: DeployUtils.encodeConstructor(
                    abi.encodeCall(IProxy.__constructor__, (address(superchainProxyAdmin)))
                )
            })
        );
        _tryStopBroadcast(b1);

        // 由本合约（当前是 ProxyAdmin 的 owner）执行 upgradeAndCall
        // **关键修复**：initialize 需要 (guardian, paused)
        bytes memory data = abi.encodeCall(
            ISuperchainConfig.initialize,
            (_in.guardian)
        );

        bool b2 = _tryStartBroadcast(_in.deployer);
        superchainProxyAdmin.upgradeAndCall(
            payable(address(superchainConfigProxy)),
            address(superchainConfigImpl),
            data
        );
        _tryStopBroadcast(b2);

        vm.label(address(superchainConfigProxy), "SuperchainConfigProxy");
        _out.superchainConfigProxy = superchainConfigProxy;
    }

    function _deployAndInitProtocolVersions(InternalInput memory _in, Output memory _out) private {
        IProxyAdmin superchainProxyAdmin = _out.superchainProxyAdmin;
        IProtocolVersions protocolVersionsImpl = _out.protocolVersionsImpl;

        bool b1 = _tryStartBroadcast(_in.deployer);
        IProtocolVersions protocolVersionsProxy = IProtocolVersions(
            DeployUtils.create1({
                _name: "Proxy",
                _args: DeployUtils.encodeConstructor(
                    abi.encodeCall(IProxy.__constructor__, (address(superchainProxyAdmin)))
                )
            })
        );
        _tryStopBroadcast(b1);

        // **关键修复**：参数顺序必须是 (owner, recommended, required)
        bytes memory data = abi.encodeCall(
            IProtocolVersions.initialize,
            (_in.protocolVersionsOwner, _in.recommendedProtocolVersion, _in.requiredProtocolVersion)
        );

        bool b2 = _tryStartBroadcast(_in.deployer);
        superchainProxyAdmin.upgradeAndCall(
            payable(address(protocolVersionsProxy)),
            address(protocolVersionsImpl),
            data
        );
        _tryStopBroadcast(b2);

        vm.label(address(protocolVersionsProxy), "ProtocolVersionsProxy");
        _out.protocolVersionsProxy = protocolVersionsProxy;
    }

    function _transferProxyAdminOwnership(InternalInput memory _in, Output memory _out) private {
        bool b = _tryStartBroadcast(_in.deployer);
        _out.superchainProxyAdmin.transferOwnership(_in.superchainProxyAdminOwner);
        _tryStopBroadcast(b);
    }

    // ---------- 断言（不使用 prank） ----------
    function _assertValidInput(InternalInput memory _in) internal pure {
        require(_in.guardian != address(0), "input.guardian");
        require(_in.protocolVersionsOwner != address(0), "input.pvOwner");
        require(ProtocolVersion.unwrap(_in.requiredProtocolVersion) != 0, "input.required=0");
        require(ProtocolVersion.unwrap(_in.recommendedProtocolVersion) != 0, "input.recommended=0");
        require(_in.superchainProxyAdminOwner != address(0), "input.proxyAdminOwner");
    }

    function _assertValidOutput(InternalInput memory _in, Output memory _out) internal view {
        require(address(_out.superchainProxyAdmin) != address(0), "out.proxyAdmin=0");
        require(address(_out.superchainConfigImpl) != address(0), "out.scImpl=0");
        require(address(_out.superchainConfigProxy) != address(0), "out.scProxy=0");
        require(address(_out.protocolVersionsImpl) != address(0), "out.pvImpl=0");
        require(address(_out.protocolVersionsProxy) != address(0), "out.pvProxy=0");

        // EIP-1967 槽一致性
        address scImpl = _readEIP1967(address(_out.superchainConfigProxy), _EIP1967_IMPLEMENTATION_SLOT);
        address scAdm  = _readEIP1967(address(_out.superchainConfigProxy), _EIP1967_ADMIN_SLOT);
        require(scImpl == address(_out.superchainConfigImpl), "SC.impl mismatch");
        require(scAdm  == address(_out.superchainProxyAdmin), "SC.admin mismatch");

        address pvImpl = _readEIP1967(address(_out.protocolVersionsProxy), _EIP1967_IMPLEMENTATION_SLOT);
        address pvAdm  = _readEIP1967(address(_out.protocolVersionsProxy), _EIP1967_ADMIN_SLOT);
        require(pvImpl == address(_out.protocolVersionsImpl), "PV.impl mismatch");
        require(pvAdm  == address(_out.superchainProxyAdmin), "PV.admin mismatch");

        // 代理上的可见状态
        require(_out.superchainConfigProxy.guardian() == _in.guardian, "SC.guardian wrong");
        require(_out.superchainConfigProxy.paused() == _in.paused, "SC.paused wrong");

        require(_out.protocolVersionsProxy.owner() == _in.protocolVersionsOwner, "PV.owner wrong");
        require(
            ProtocolVersion.unwrap(_out.protocolVersionsProxy.recommended())
                == ProtocolVersion.unwrap(_in.recommendedProtocolVersion),
            "PV.recommended wrong"
        );
        require(
            ProtocolVersion.unwrap(_out.protocolVersionsProxy.required())
                == ProtocolVersion.unwrap(_in.requiredProtocolVersion),
            "PV.required wrong"
        );
    }

    // ---------- utils ----------
    function toInternalInput(Input memory _in) internal pure returns (InternalInput memory r) {
        r = InternalInput({
            guardian: _in.guardian,
            protocolVersionsOwner: _in.protocolVersionsOwner,
            superchainProxyAdminOwner: _in.superchainProxyAdminOwner,
            deployer: address(0),
            paused: _in.paused,
            recommendedProtocolVersion: ProtocolVersion.wrap(uint256(_in.recommendedProtocolVersion)),
            requiredProtocolVersion: ProtocolVersion.wrap(uint256(_in.requiredProtocolVersion))
        });
    }
}
